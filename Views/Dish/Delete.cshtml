@model wt_lab4_4mvc_savostikova.Models.Dish

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm rounded-4 border-danger">
                <div class="card-body p-4 text-center">
                    <h2 class="mb-4 text-danger">Удаление блюда</h2>
                    
                    <p class="fs-5">Вы уверены, что хотите удалить это блюдо?</p>
                    
                    <div class="alert alert-secondary mt-4">
                        <h4>@Model.Name</h4>
                        <p class="mb-1">Категория: @Model.Category</p>
                        <p class="mb-0 fw-bold">Цена: @Model.Price руб.</p>
                    </div>

                    <form asp-action="Delete" method="post" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">Да, удалить</button>
                        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>